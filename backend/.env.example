# ============================================================
# TradeMind Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.
# ============================================================

# Environment
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Session
SESSION_TTL_SECONDS=3600
MAX_SESSIONS_PER_CLIENT=10

# Security — REQUIRED
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
ENCRYPTION_KEY=
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# MySQL Database — REQUIRED
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DB=trademind

# OpenRouter LLM (get key from https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001
LLM_MAX_TOKENS=200
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=10.0

# Gemini Translation (optional, for /api/v1/translate proxy)
GEMINI_API_KEY=

# Live Chat & Seller Assist
# Assist runs deterministically in-process; requires 0 LLM calls.
